# Google Apps Script Web App URL (doPost → Sheet-এ row append)
# Section 10 দেখো। এটা সার্ভার-সাইড only, কখনো NEXT_PUBLIC_ দিয়ে নয়।
SHEET_WEBHOOK_URL=

# WhatsApp নম্বর — শুধু ডিজিট, country code সহ। যেমন: 8801XXXXXXXXX
# খালি থাকলে WhatsApp বাটন disabled থাকবে + "শীঘ্রই" দেখাবে।
NEXT_PUBLIC_WHATSAPP=

# ডোমেইন বরাদ্দ হলে বসবে (canonical / OG / sitemap-এর base URL)
NEXT_PUBLIC_SITE_URL=

# সোশ্যাল লিংক — নতুন পেজ খোলা হলে বসবে। খালি থাকলে chip inactive থাকে।
NEXT_PUBLIC_FACEBOOK=
NEXT_PUBLIC_YOUTUBE=
